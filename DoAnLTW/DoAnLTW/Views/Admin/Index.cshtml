@{
    ViewData["Title"] = "Quản Lý Hệ Thống - Basau Bags";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="container my-5">
    <!-- Header Admin Banner -->
    <header class="bg-dark text-white rounded-4 p-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="fs-4 fw-bold mb-1 text-white" style="font-family: 'Oswald', sans-serif;">
                QUẢN LÝ CỬA HÀNG TÚI XÁCH (DÀNH CHO NGƯỜI BÁN)
            </h1>
            <p class="mb-0 text-white-50 small" id="adminUserLabel"
               data-server-user="@(User.Identity?.Name ?? "")"
               data-server-auth="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
               data-server-role="@userRole">Hệ thống quản trị danh mục và đơn hàng</p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 fw-bold">Về trang chủ</a>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="bg-white border rounded-4 px-3 pt-3 mb-4 shadow-sm" aria-label="Admin Navigation Tabs">
        <ul class="nav nav-tabs border-0" id="adm-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold active adm-tab border-0 border-bottom border-3 border-dark rounded-0 px-4 py-3"
                    id="adm-tab-add" onclick="switchAdminTab('add')">Thêm túi xách mới</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold adm-tab border-0 rounded-0 px-4 py-3"
                    id="adm-tab-edit" onclick="switchAdminTab('edit')">Điều chỉnh thông tin</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold adm-tab border-0 rounded-0 px-4 py-3"
                    id="adm-tab-delete" onclick="switchAdminTab('delete')">Xóa sản phẩm</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold adm-tab border-0 rounded-0 px-4 py-3"
                    id="adm-tab-orders" onclick="switchAdminTab('orders')">Đơn đặt hàng</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold adm-tab border-0 rounded-0 px-4 py-3"
                    id="adm-tab-stats" onclick="switchAdminTab('stats')">Báo cáo & Thống kê</button>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main class="site-main">
        <partial name="Partials/_TabAddProduct" />
        <partial name="Partials/_TabEditProduct" />
        <partial name="Partials/_TabDeleteProduct" />
        <partial name="Partials/_TabOrders" />
        <partial name="Partials/_TabStats" />
    </main>
</div>

@section Scripts {
    <script src="~/js/data.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof initAdminStats === 'function') {
                initAdminStats();
            }
            if (typeof filterAdminList === 'function') {
                filterAdminList('edit');
                filterAdminList('delete');
            }
        });
    </script>
}

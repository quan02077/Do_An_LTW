@model DoAnLTW.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-page py-5">
    <div class="auth-card shadow-sm p-4 p-md-5 rounded-4 bg-white border" style="max-width: 480px; margin: 0 auto;">
        @if (TempData["AuthError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show small py-2 mb-3 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["AuthError"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="text-center mb-4 pb-2 border-bottom">
            <p class="eyebrow text-uppercase text-secondary small fw-bold mb-1">KHÔI PHỤC TÀI KHOẢN</p>
            <h1 class="fw-bold oswald-font mb-1" style="font-size: 2rem;">QUÊN MẬT KHẨU</h1>
            <p class="text-muted small mb-0">Xác thực tên đăng nhập & email đã đăng ký để đặt lại mật khẩu mới</p>
        </div>

        <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label text-uppercase fw-bold small text-secondary">Tên đăng nhập *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-secondary"></i></span>
                    <input asp-for="TenDangNhap" class="form-control rounded-end-3 border-start-0" autocomplete="username" placeholder="Nhập tên đăng nhập cần lấy lại" />
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-uppercase fw-bold small text-secondary">Email đã đăng ký *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-secondary"></i></span>
                    <input asp-for="Email" class="form-control rounded-end-3 border-start-0" type="email" autocomplete="email" placeholder="VD: example@gmail.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MatKhauMoi" class="form-label text-uppercase fw-bold small text-secondary">Mật khẩu mới *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-secondary"></i></span>
                    <input asp-for="MatKhauMoi" class="form-control rounded-end-3 border-start-0 forgot-pwd-field" id="newPasswordInput" type="password" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="XacNhanMatKhau" class="form-label text-uppercase fw-bold small text-secondary">Xác nhận mật khẩu mới *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-check2-circle text-secondary"></i></span>
                    <input asp-for="XacNhanMatKhau" class="form-control rounded-end-3 border-start-0 forgot-pwd-field" id="confirmPasswordInput" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                </div>
                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" role="switch" id="showForgotPass" onchange="toggleForgotPasswords(this)">
                <label class="form-check-label small text-secondary" for="showForgotPass">Hiển thị mật khẩu</label>
            </div>

            <button type="submit" class="btn btn-dark w-100 rounded-pill py-3 fw-bold shadow-sm text-uppercase" style="letter-spacing: 1px;">
                <i class="bi bi-arrow-repeat me-1"></i> ĐẶT LẠI MẬT KHẨU
            </button>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top small">
                <a asp-action="Login" class="text-dark fw-bold text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                </a>
                <a asp-action="Register" class="text-secondary text-decoration-none">
                    Đăng ký tài khoản
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleForgotPasswords(chk) {
            const type = chk.checked ? 'text' : 'password';
            const p1 = document.getElementById('newPasswordInput');
            const p2 = document.getElementById('confirmPasswordInput');
            if (p1) p1.type = type;
            if (p2) p2.type = type;
        }
    </script>
}

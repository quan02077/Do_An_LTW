@model DoAnLTW.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<section class="profile-page py-5 bg-light">
    <div class="container" style="max-width: 1080px;">
        <!-- Thông báo thao tác -->
        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-medium">@TempData["ProfileSuccess"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ProfileError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-medium">@TempData["ProfileError"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["PasswordError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-shield-x me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-medium">@TempData["PasswordError"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Tiêu đề trang -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-2 border-bottom">
            <div>
                <p class="eyebrow text-uppercase text-secondary small fw-bold mb-1" style="letter-spacing: 1px;">TÀI KHOẢN CỦA TÔI</p>
                <h1 class="fw-bold oswald-font mb-0" style="font-size: 2.2rem;">HỒ SƠ KHÁCH HÀNG</h1>
            </div>
            <div class="d-flex gap-2 mt-2 mt-md-0">
                <a asp-controller="Orders" asp-action="History" class="btn btn-outline-dark rounded-pill px-3 py-2 small fw-semibold">
                    <i class="bi bi-receipt me-1"></i> Lịch sử đơn hàng
                </a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-dark rounded-pill px-3 py-2 small fw-semibold">
                    <i class="bi bi-bag me-1"></i> Giỏ hàng
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- CỘT TRÁI: THẺ TỔNG QUAN HỒ SƠ -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 mb-4 bg-white">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center shadow-sm"
                             style="width: 88px; height: 88px; font-size: 2.4rem; font-weight: bold;">
                            @(string.IsNullOrWhiteSpace(Model.HoTen) ? "U" : Model.HoTen.Trim()[0].ToString().ToUpper())
                        </div>
                    </div>
                    <h4 class="fw-bold mb-1">@Model.HoTen</h4>
                    <p class="text-muted small mb-2">&#64;@Model.TenDangNhap</p>
                    <div>
                        <span class="badge @(Model.VaiTro == DoAnLTW.Models.Roles.Admin ? "bg-danger" : "bg-dark") px-3 py-2 rounded-pill fw-medium">
                            <i class="bi @(Model.VaiTro == DoAnLTW.Models.Roles.Admin ? "bi-shield-lock" : "bi-person-check") me-1"></i>@Model.VaiTro
                        </span>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- Thống kê nhanh -->
                    <div class="row text-center g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <div class="text-secondary small fw-bold">ĐƠN HÀNG</div>
                                <div class="fs-4 fw-bold text-dark">@Model.SoDonHang</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <div class="text-secondary small fw-bold">TÍCH LŨY</div>
                                <div class="fs-6 fw-bold text-danger mt-1">@Model.TongChiTieu.ToString("N0") đ</div>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách thông tin liên lạc tóm tắt -->
                    <div class="text-start small text-secondary mt-2">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-envelope-fill me-2 text-dark"></i>
                            <span class="text-truncate">@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa có email" : Model.Email)</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-telephone-fill me-2 text-dark"></i>
                            <span>@(string.IsNullOrWhiteSpace(Model.SoDienThoai) ? "Chưa có SĐT" : Model.SoDienThoai)</span>
                        </div>
                        <div class="d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill me-2 text-dark mt-1"></i>
                            <span>@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật địa chỉ" : Model.DiaChi)</span>
                        </div>
                    </div>

                    @if (User.IsInRole(DoAnLTW.Models.Roles.Admin) || User.IsInRole("Admin"))
                    {
                        <hr class="my-3 text-muted" />
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-danger w-100 rounded-pill fw-bold small py-2">
                            <i class="bi bi-gear-wide-connected me-1"></i> Quản trị cửa hàng
                        </a>
                    }

                    <hr class="my-3 text-muted" />
                    <form asp-controller="Account" asp-action="Logout" method="post" onsubmit="try { localStorage.removeItem('currentUser'); } catch(e) {}">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger text-decoration-none fw-semibold small p-0">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất tài khoản
                        </button>
                    </form>
                </div>
            </div>

            <!-- CỘT PHẢI: CHỈNH SỬA THÔNG TIN & ĐỔI MẬT KHẨU -->
            <div class="col-lg-8">
                <!-- THẺ 1: XEM & CHỈNH SỬA THÔNG TIN CÁ NHÂN -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                        <div>
                            <h3 class="fw-bold oswald-font mb-1" style="font-size: 1.5rem;">
                                <i class="bi bi-person-lines-fill text-dark me-2"></i>THÔNG TIN CÁ NHÂN
                            </h3>
                            <p class="text-muted small mb-0">Cập nhật họ tên, email, số điện thoại và địa chỉ nhận hàng của bạn</p>
                        </div>
                    </div>

                    <form asp-action="Profile" method="post" id="profileForm">
                        @Html.AntiForgeryToken()
                        <input asp-for="MaKH" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <!-- Tên đăng nhập & Vai trò (chỉ xem, không cho đổi tên đăng nhập) -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="TenDangNhap" class="form-label text-uppercase fw-bold small text-secondary">Tên đăng nhập</label>
                                <input asp-for="TenDangNhap" class="form-control rounded-3 bg-light text-muted" readonly />
                                <small class="text-muted" style="font-size: 0.75rem;">Tên đăng nhập được cố định trong hệ thống</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VaiTro" class="form-label text-uppercase fw-bold small text-secondary">Vai trò hệ thống</label>
                                <input asp-for="VaiTro" class="form-control rounded-3 bg-light text-muted" readonly />
                            </div>
                        </div>

                        <!-- Họ và tên -->
                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label text-uppercase fw-bold small text-secondary">Họ và tên *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-secondary"></i></span>
                                <input asp-for="HoTen" class="form-control rounded-end-3 border-start-0" placeholder="Nhập họ và tên đầy đủ" />
                            </div>
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <!-- Email & Số điện thoại -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-7">
                                <label asp-for="Email" class="form-label text-uppercase fw-bold small text-secondary">Địa chỉ Email *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-secondary"></i></span>
                                    <input asp-for="Email" class="form-control rounded-end-3 border-start-0" type="email" placeholder="example@gmail.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="SoDienThoai" class="form-label text-uppercase fw-bold small text-secondary">Số điện thoại *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-phone text-secondary"></i></span>
                                    <input asp-for="SoDienThoai" class="form-control rounded-end-3 border-start-0" placeholder="09xxxxxxxx" />
                                </div>
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Địa chỉ giao hàng -->
                        <div class="mb-4">
                            <label asp-for="DiaChi" class="form-label text-uppercase fw-bold small text-secondary">Địa chỉ nhận hàng mặc định</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-secondary"></i></span>
                                <input asp-for="DiaChi" class="form-control rounded-end-3 border-start-0" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành" />
                            </div>
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-dark rounded-pill px-4 py-2 fw-bold text-uppercase shadow-sm" style="letter-spacing: 0.5px;">
                                <i class="bi bi-check2-circle me-1"></i> LƯU THÔNG TIN MỚI
                            </button>
                        </div>
                    </form>
                </div>

                <!-- THẺ 2: ĐỔI MẬT KHẨU BẢO MẬT -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                        <div>
                            <h3 class="fw-bold oswald-font mb-1" style="font-size: 1.5rem;">
                                <i class="bi bi-shield-lock text-dark me-2"></i>ĐỔI MẬT KHẨU
                            </h3>
                            <p class="text-muted small mb-0">Bảo mật tài khoản của bạn bằng cách cập nhật mật khẩu định kỳ</p>
                        </div>
                    </div>

                    <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label for="MatKhauHienTai" class="form-label text-uppercase fw-bold small text-secondary">Mật khẩu hiện tại *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-secondary"></i></span>
                                <input type="password" name="MatKhauHienTai" id="currPassInput" class="form-control rounded-end-3 border-start-0 pwd-change-input" placeholder="Nhập mật khẩu đang sử dụng" required />
                            </div>
                        </div>

                        <!-- Mật khẩu mới & Xác nhận mật khẩu mới -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="MatKhauMoi" class="form-label text-uppercase fw-bold small text-secondary">Mật khẩu mới *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-secondary"></i></span>
                                    <input type="password" name="MatKhauMoi" id="newPassInput" class="form-control rounded-end-3 border-start-0 pwd-change-input" placeholder="Tối thiểu 6 ký tự" minlength="6" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="XacNhanMatKhauMoi" class="form-label text-uppercase fw-bold small text-secondary">Xác nhận mật khẩu mới *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-secondary"></i></span>
                                    <input type="password" name="XacNhanMatKhauMoi" id="confirmPassInput" class="form-control rounded-end-3 border-start-0 pwd-change-input" placeholder="Nhập lại mật khẩu mới" minlength="6" required />
                                </div>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" role="switch" id="toggleChangePassSwitch" onchange="toggleChangePasswords(this)">
                            <label class="form-check-label small text-secondary" for="toggleChangePassSwitch">Hiển thị mật khẩu</label>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold text-uppercase shadow-sm">
                                <i class="bi bi-shield-check me-1"></i> CẬP NHẬT MẬT KHẨU
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleChangePasswords(chk) {
            const type = chk.checked ? 'text' : 'password';
            document.querySelectorAll('.pwd-change-input').forEach(el => el.type = type);
        }
    </script>
}

@model DoAnLTW.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page">
    <form asp-action="Login" method="post" class="auth-card">
        <input asp-for="ReturnUrl" type="hidden" />
        <p class="eyebrow">TÀI KHOẢN</p>
        <h1>Đăng nhập</h1>
        <p class="text-muted">Đăng nhập để sử dụng giỏ hàng và theo dõi đơn hàng.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="TenDangNhap" class="form-label"></label>
            <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="MatKhau" class="form-label"></label>
            <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-dark w-100">Đăng nhập</button>
        <p class="demo-account">Tài khoản demo: <strong>customer.demo</strong> / <strong>Customer@123</strong></p>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Basau Bags</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Oswald:wght@200..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/stylesMain.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidepanels.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid p-0">
        <header id="main-header" class="site-header">
            <div class="rowHeader bg-light py-1 px-3 border-bottom">
                <div class="container-fluid px-4 d-flex justify-content-end align-items-center gap-4">
                    <div class="tienich" id="adminMenuWrap">
                        <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none" id="QL_btn">Quản lý sản phẩm</a>
                    </div>
                    <div class="tienich">
                        <a asp-controller="Cart" asp-action="Index" class="text-secondary text-decoration-none">
                            <span id="cartCountText">Giỏ hàng</span>
                        </a>
                    </div>
                    <div class="tienich">
                        <a asp-controller="Orders" asp-action="History" class="text-secondary text-decoration-none">Đơn hàng</a>
                    </div>
                    <div class="tienich">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-secondary me-2">Xin chào, <strong>@User.Identity.Name</strong></span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 small fw-bold">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none fw-bold" id="userAccountLink">
                                <span id="userAccountText">Đăng nhập</span>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="container-fluid rowMenu bg-white sticky-top shadow-sm py-3 px-4 px-md-5">
                <div class="container d-flex align-items-center justify-content-between">
                    <div class="logo d-flex justify-content-start align-items-center" style="flex: 1;">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                            <span class="oswald-font fw-bold fs-2" style="letter-spacing: 2px;">BASAU<span class="text-danger">.BAGS</span></span>
                        </a>
                    </div>

                    <div class="menu-toggle d-lg-none" style="cursor: pointer;">
                        <span class="bar"></span>
                        <span class="bar"></span>
                        <span class="bar"></span>
                    </div>

                    <nav class="menu d-none d-lg-flex justify-content-center align-items-center" id="nav-menu" style="flex: 2;">
                        <a asp-controller="Home" asp-action="Index" class="text-dark text-decoration-none menu-link">TẤT CẢ</a>

                        <div class="dropdown">
                            <a href="#" class="text-dark text-decoration-none menu-link">LOẠI TÚI</a>
                            <div class="mega-menu p-4">
                                <div class="container">
                                    <div class="row text-start g-3">
                                        <div class="col-4">
                                            <h6 class="fw-bold text-white border-bottom border-secondary pb-2">THÔNG DỤNG</h6>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Balo thời trang</a>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Túi đeo chéo</a>
                                        </div>
                                        <div class="col-4">
                                            <h6 class="fw-bold text-white border-bottom border-secondary pb-2">THANH LỊCH</h6>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Túi đeo vai</a>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Túi tote</a>
                                        </div>
                                        <div class="col-4">
                                            <h6 class="fw-bold text-white border-bottom border-secondary pb-2">SỰ KIỆN</h6>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Clutch dự tiệc</a>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Túi dự tiệc</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="dropdown">
                            <a href="#" class="text-dark text-decoration-none menu-link">THƯƠNG HIỆU</a>
                            <div class="mega-menu p-4">
                                <div class="container">
                                    <div class="row text-start g-3">
                                        <div class="col-4">
                                            <h6 class="fw-bold text-white border-bottom border-secondary pb-2">QUỐC TẾ</h6>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">CHARLES & KEITH</a>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Pedro</a>
                                        </div>
                                        <div class="col-4">
                                            <h6 class="fw-bold text-white border-bottom border-secondary pb-2">NỘI ĐỊA CAO CẤP</h6>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">ELLY</a>
                                        </div>
                                        <div class="col-4">
                                            <h6 class="fw-bold text-white border-bottom border-secondary pb-2">TRẺ TRUNG & TIỆN ÍCH</h6>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Natoli</a>
                                            <a href="#" class="d-block text-white-50 text-decoration-none py-1 hover-white">Jamlos</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <a href="#" class="text-danger text-decoration-none menu-link fw-bold">KHUYẾN MÃI</a>
                    </nav>

                    <div class="searchBar d-none d-lg-flex" style="flex: 1; justify-content: flex-end;">
                        <input type="text" class="form-control rounded-pill custom-search" placeholder="Tìm kiếm túi xách, balo...">
                    </div>
                </div>
            </div>
        </header>

        <main class="site-main flex-grow-1">
            @RenderBody()
        </main>

        <footer class="site-footer w-100 text-white text-center py-5 mt-auto">
            <div class="container py-2">
                <a asp-controller="Home" asp-action="Index" class="footer-logo-link text-decoration-none">
                    <h1 class="oswald-font fw-bold mb-2 footer-logo-text">BASAU<span class="text-danger">.BAGS</span></h1>
                </a>
                <p class="small mb-0 text-white-50" style="cursor: default;">© 2026 BASAU BAGS STORE - QUẢN LÝ TÚI XÁCH. All rights reserved.</p>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

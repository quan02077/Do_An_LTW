<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Basau Bags</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Oswald:wght@200..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/stylesMain.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidepanels.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="container-fluid p-0 d-flex flex-column min-vh-100">
        <!-- Header Partial View -->
        <partial name="_Header" />

        <!-- Main Content -->
        <main class="site-main flex-grow-1">
            @RenderBody()
        </main>

        <!-- Footer Partial View -->
        <partial name="_Footer" />
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.serverUsername = '@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "")';
        window.serverRole = '@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "")';
        window.serverIsAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

        // Đồng bộ trạng thái đăng nhập từ server vào localStorage để các script phía client nhận diện
        if (window.serverIsAuthenticated && window.serverUsername) {
            try {
                let localUser = localStorage.getItem('currentUser');
                let parsed = localUser ? JSON.parse(localUser) : null;
                if (!parsed || parsed.username !== window.serverUsername || parsed.role !== window.serverRole) {
                    localStorage.setItem('currentUser', JSON.stringify({
                        username: window.serverUsername,
                        fullname: window.serverUsername,
                        role: window.serverRole || 'Khách hàng'
                    }));
                }
            } catch (e) {}
        }

        // Toggle mobile menu khi click icon hamburger
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtn = document.getElementById('mobileMenuToggle');
            var navMenu = document.getElementById('nav-menu');
            if (toggleBtn && navMenu) {
                toggleBtn.addEventListener('click', function() {
                    navMenu.classList.toggle('d-none');
                    navMenu.classList.toggle('d-flex');
                    navMenu.classList.toggle('flex-column');
                    navMenu.classList.toggle('w-100');
                    navMenu.classList.toggle('py-3');
                });
            }
        });
    </script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/favourite.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

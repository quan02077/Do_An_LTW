@inject DoAnLTW.Services.ICartService cartService
@inject DoAnLTW.Services.ICurrentCustomerService currentCustomer
@{
    int headerCartCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var custId = await currentCustomer.GetCustomerIdAsync();
        if (custId.HasValue)
        {
            var cart = await cartService.GetAsync(custId.Value);
            headerCartCount = cart.TongSoLuong;
        }
    }
}
<header id="main-header" class="site-header">
    <div class="rowHeader bg-light py-1 px-3 border-bottom">
        <div class="container-fluid px-4 d-flex justify-content-end align-items-center gap-4">
            <div class="tienich">
                <a asp-controller="Cart" asp-action="Index" class="text-secondary text-decoration-none">
                    <i class="bi bi-bag me-1"></i><span id="cartCountText">Giỏ hàng @(headerCartCount > 0 ? $"({headerCartCount})" : "")</span>
                </a>
            </div>
            <div class="tienich">
                <a asp-controller="Orders" asp-action="History" class="text-secondary text-decoration-none">
                    <i class="bi bi-clock-history me-1"></i><span>Đơn hàng</span>
                </a>
            </div>
            <div class="tienich">
                <a href="#" class="text-secondary text-decoration-none" onclick="handleFavLinkClick(event)">
                    <span>Yêu thích</span>
                </a>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var notiScope = $"{User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? User.Identity?.Name ?? "user"}_{(User.IsInRole(DoAnLTW.Models.Roles.Admin) ? "admin" : "customer")}";
                <div class="tienich noti-bell-wrapper" data-noti-bell data-noti-scope="@notiScope">
                    <button type="button" class="noti-bell-btn" data-noti-toggle aria-expanded="false" aria-label="Thông báo đơn hàng" title="Thông báo đơn hàng">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2m.995-14.901a1 1 0 1 0-1.99 0A5 5 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901"/>
                        </svg>
                        <span class="noti-badge d-none" data-noti-badge>0</span>
                    </button>
                    <div class="noti-panel" data-noti-panel role="region" aria-label="Danh sách thông báo">
                        <div class="noti-panel-header">
                            <span class="noti-panel-title">Thông báo</span>
                            <button type="button" class="noti-clear-btn" data-noti-clear>Xóa tất cả</button>
                        </div>
                        <ul class="noti-list" data-noti-list>
                            <li class="noti-empty">Chưa có thông báo nào.</li>
                        </ul>
                    </div>
                </div>
            }
            <div class="tienich">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Account" asp-action="Profile" class="text-dark fw-semibold text-decoration-none me-2" title="Xem hồ sơ cá nhân">
                        <i class="bi bi-person-circle text-secondary me-1"></i><span>@(User.Identity?.Name)</span>
                    </a>
                    <span class="text-muted me-2">|</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" onsubmit="try { localStorage.removeItem('currentUser'); } catch(e) {}">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 small fw-bold">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none fw-bold" id="userAccountLink">
                        <span id="userAccountText">Đăng nhập</span>
                    </a>
                    <span class="text-muted mx-1">/</span>
                    <a asp-controller="Account" asp-action="Register" class="text-secondary text-decoration-none fw-bold">
                        <span>Đăng ký</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="container-fluid rowMenu bg-white sticky-top shadow-sm py-3 px-4 px-md-5">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="logo d-flex justify-content-start align-items-center" style="flex: 1;">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark d-flex align-items-center gap-2">
                    <span class="oswald-font fw-bold fs-2" style="letter-spacing: 2px;">BASAU<span class="text-danger">.BAGS</span></span>
                </a>
            </div>

            <div class="menu-toggle d-lg-none" style="cursor: pointer;" id="mobileMenuToggle">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>

            <nav class="menu d-none d-lg-flex justify-content-center align-items-center" id="nav-menu" style="flex: 2;">
                <a asp-controller="Catalog" asp-action="Index" class="text-dark text-decoration-none menu-link">TẤT CẢ</a>

                @await Component.InvokeAsync("Menu")

                <a asp-controller="FlashSale" asp-action="Index" class="text-danger text-decoration-none menu-link fw-bold">KHUYẾN MÃI</a>
            </nav>

            <div class="searchBar d-none d-lg-flex" style="flex: 1; justify-content: flex-end;">
                <form action="/Catalog" method="get" class="w-auto">
                    <input type="text" name="q" class="form-control rounded-pill custom-search" placeholder="Tìm kiếm túi xách, balo...">
                </form>
            </div>
        </div>
    </div>
</header>

@model DoAnLTW.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ - Cửa Hàng Túi Xách & Balo Thời Trang";
}

<!-- thông báo thao tác giỏ hàng -->
@if (TempData["CartSuccess"] != null)
{
    <div class="container my-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["CartSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["CartError"] != null)
{
    <div class="container my-3">
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["CartError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (User.IsInRole(DoAnLTW.Models.Roles.Admin) || User.IsInRole("Admin") || string.Equals(User.Identity?.Name, "admin", StringComparison.OrdinalIgnoreCase))
{
    <div class="container my-3">
        <div class="alert alert-dark d-flex justify-content-between align-items-center flex-wrap gap-3 border-0 shadow-sm rounded-4 p-3 mb-0" style="background: linear-gradient(135deg, #1f2937, #111827); color: #fff;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark px-2 py-1 fw-bold"><i class="bi bi-shield-lock-fill me-1"></i>ADMIN</span>
                <span>Xin chào Quản trị viên <strong>@User.Identity?.Name</strong>! Bạn đang ở chế độ xem trang chủ của khách hàng.</span>
            </div>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-warning text-dark fw-bold rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-speedometer2"></i> Chuyển sang Trang Quản Trị
            </a>
        </div>
    </div>
}

<partial name="Partials/_HeroSlider" />
<partial name="Partials/_HotProducts" model="Model" />
<partial name="Partials/_FlashSaleBanner" />
<partial name="Partials/_FeaturedBrands" model="Model" />

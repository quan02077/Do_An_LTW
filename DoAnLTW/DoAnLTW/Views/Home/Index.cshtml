@model DoAnLTW.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ - Cửa Hàng Túi Xách & Balo Thời Trang";
}

<!-- thông báo thao tác giỏ hàng -->
@if (TempData["CartSuccess"] != null)
{
    <div class="container my-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["CartSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["CartError"] != null)
{
    <div class="container my-3">
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["CartError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<partial name="Partials/_HeroSlider" />
<partial name="Partials/_HotProducts" model="Model" />
<partial name="Partials/_FlashSaleBanner" />
<partial name="Partials/_FeaturedBrands" model="Model" />

@model DoAnLTW.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ - Cửa Hàng Túi Xách & Balo Thời Trang";
}

<!-- thông báo thao tác giỏ hàng -->
@if (TempData["CartSuccess"] != null)
{
    <div class="container my-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["CartSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["CartError"] != null)
{
    <div class="container my-3">
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["CartError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (User.IsInRole(DoAnLTW.Models.Roles.Admin) || User.IsInRole("Admin"))
{
    <div class="container my-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 border rounded-0" style="background-color: #f8f9fa; border-color: #e5e7eb !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-uppercase px-2 py-1 border rounded-0" style="font-size: 11px; letter-spacing: 0.5px; background-color: #e5e7eb; color: #374151; border-color: #d1d5db !important;">Admin</span>
                <span style="color: #4b5563; font-size: 14px;">Xin chào Quản trị viên <strong>@User.Identity?.Name</strong>. Bạn đang xem giao diện người dùng.</span>
            </div>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn text-white fw-semibold px-3 py-2 rounded-0 text-decoration-none" style="font-size: 13px; background-color: #4b5563; border: 1px solid #4b5563;">
                Vào trang quản trị
            </a>
        </div>
    </div>
}

<partial name="Partials/_HeroSlider" />
<partial name="Partials/_HotProducts" model="Model" />
<partial name="Partials/_FlashSaleBanner" />
<partial name="Partials/_FeaturedBrands" model="Model" />

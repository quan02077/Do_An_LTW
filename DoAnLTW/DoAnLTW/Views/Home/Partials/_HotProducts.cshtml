@model DoAnLTW.ViewModels.HomeIndexViewModel
@{
    string ResolveImage(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return Url.Content("~/HinhAnh/logo.jpg");
        if (path.StartsWith("~"))
            return Url.Content(path);
        if (path.StartsWith("/"))
            return Url.Content("~" + path);
        return Url.Content("~/HinhAnh/" + path);
    }
}

<!-- Lưới Sản Phẩm Nổi Bật & Bán Chạy -->
<section id="featured-products" class="container-fluid my-5 px-4 px-md-5 py-3">
    <div class="d-flex justify-content-between align-items-end mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold oswald-font mb-1" style="font-size: 2rem; line-height: 1.4;">TÚI XÁCH BÁN CHẠY & NỔI BẬT</h2>
            <p class="text-secondary small mb-0">Các mẫu túi xách và balo được chọn lọc nhiều nhất trong tháng (@Model.HotProducts.Count sản phẩm)</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-bold">Tất cả sản phẩm</a>
    </div>

    <div class="row g-4" id="hotProductsContainer">
        @if (Model.HotProducts != null && Model.HotProducts.Any())
        {
            @foreach (var product in Model.HotProducts)
            {
                var imgUrl = ResolveImage(product.HinhAnh);
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="product-card border p-3 rounded shadow-sm text-center position-relative h-100 d-flex flex-column bg-white">
                        <!-- Nhãn badge từ CSDL (3 loại: Đang giảm giá, Bán chạy, Hàng mới về) -->
                        @if (product.SoLuongTonKho <= 0)
                        {
                            <span class="badge bg-secondary position-absolute top-0 end-0 m-2 shadow-sm">Hết hàng</span>
                        }
                        else if (!string.IsNullOrEmpty(product.Badge))
                        {
                            if (product.Badge.Contains("Sale") || product.Badge.Contains("giảm giá", StringComparison.OrdinalIgnoreCase))
                            {
                                var saleText = product.PhanTramGiam > 0 ? $"-{(int)product.PhanTramGiam}%" : "SALE";
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2 shadow-sm" title="@product.Badge">@saleText</span>
                            }
                            else if (product.Badge.Contains("Best Seller", StringComparison.OrdinalIgnoreCase) || product.Badge.Contains("Bán chạy", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-dark position-absolute top-0 end-0 m-2 shadow-sm" title="@product.Badge">BEST SELLER</span>
                            }
                            else if (product.Badge.Contains("New Arrival", StringComparison.OrdinalIgnoreCase) || product.Badge.Contains("mới", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary position-absolute top-0 end-0 m-2 shadow-sm" title="@product.Badge">NEW ARRIVAL</span>
                            }
                            else
                            {
                                <span class="badge bg-dark position-absolute top-0 end-0 m-2 shadow-sm">@product.Badge</span>
                            }
                        }
                        else if (product.PhanTramGiam > 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 end-0 m-2 shadow-sm">-@((int)product.PhanTramGiam)%</span>
                        }
                        else if (product.SoLuongTonKho <= 5)
                        {
                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 shadow-sm">Sắp hết</span>
                        }

                        <!-- Ảnh sản phẩm có link chi tiết -->
                        <a href="/Catalog/Detail?id=@product.MaTui" class="text-decoration-none text-dark d-block">
                            <div style="height: 190px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 12px;">
                                <img src="@imgUrl" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="@product.TenTui" loading="lazy">
                            </div>

                            <!-- Thông tin thương hiệu & loại túi -->
                            <span class="text-secondary small fw-bold text-uppercase">@product.TenThuongHieu · @product.TenLoai</span>

                            <!-- Tên sản phẩm -->
                            <h5 class="fw-bold my-2" style="font-size: 15px; min-height: 44px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.45;" title="@product.TenTui">
                                @product.TenTui
                            </h5>
                        </a>

                        <!-- Giá & Nút thêm giỏ hàng -->
                        <div class="mt-auto">
                            <p class="mb-2">
                                @if (product.PhanTramGiam > 0)
                                {
                                    <span class="text-muted text-decoration-line-through small me-2">@product.DonGiaGoc.ToString("N0") ₫</span>
                                    <span class="text-danger fw-bold fs-5">@product.DonGiaHienTai.ToString("N0") ₫</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold fs-5">@product.DonGiaHienTai.ToString("N0") ₫</span>
                                }
                            </p>

                            @if (product.SoLuongTonKho > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MaTui" value="@product.MaTui" />
                                    <input type="hidden" name="SoLuong" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-dark w-100 rounded-pill fw-bold py-2">
                                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary w-100 rounded-pill fw-bold py-2" disabled>
                                    Hết hàng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">Hiện chưa có sản phẩm nào trong cơ sở dữ liệu.</p>
            </div>
        }
    </div>
</section>

<!-- khối banner flash sale mùa thu -->
<section class="container-fluid my-5 px-4 px-md-5">
    <div class="flash-sale-banner row m-0 align-items-center rounded-4 overflow-hidden p-4 p-md-5 text-white">
        <div class="col-md-7 pe-md-5">
            <h2 class="display-6 fw-bold text-white mb-2 oswald-font">ƯU ĐÃI ĐẶC QUYỀN MÙA THU</h2>
            <p class="text-white-50 fs-5 mb-4">Săn túi xách và balo chính hãng từ các thương hiệu hàng đầu với ưu đãi giảm giá lên đến 30%.</p>
            <div class="countdown d-flex gap-3 mb-4">
                <div class="countdown-box">
                    <div class="count-num" id="days">02</div>
                    <span class="count-lbl">Ngày</span>
                </div>
                <div class="countdown-box">
                    <div class="count-num" id="hours">14</div>
                    <span class="count-lbl">Giờ</span>
                </div>
                <div class="countdown-box">
                    <div class="count-num" id="minutes">45</div>
                    <span class="count-lbl">Phút</span>
                </div>
                <div class="countdown-box">
                    <div class="count-num text-danger" id="seconds">30</div>
                    <span class="count-lbl">Giây</span>
                </div>
            </div>
            <a asp-controller="FlashSale" asp-action="Index" class="btn btn-light btn-lg px-5 fw-bold rounded-pill text-dark">SĂN SALE NGAY</a>
        </div>
        <div class="col-md-5 p-4 text-center">
            <img src="~/HinhAnh/tui1_1.png" class="img-fluid" style="max-height: 280px; object-fit: contain;" alt="Túi xách Basau">
        </div>
    </div>
</section>

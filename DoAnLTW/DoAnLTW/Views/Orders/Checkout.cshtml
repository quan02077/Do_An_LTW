@model DoAnLTW.ViewModels.CheckoutPageViewModel
@using DoAnLTW.Services
@{
    ViewData["Title"] = "Thanh toán";
}

<section class="shop-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">THANH TOÁN</p>
            <h1>Xác nhận đơn hàng</h1>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark">Quay lại giỏ hàng</a>
    </div>

    <form asp-action="Checkout" method="post" class="cart-layout checkout-layout"
          onsubmit="return confirm('Xác nhận đặt hàng với thông tin đã nhập?');">
        <div class="checkout-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <span asp-validation-for="Checkout.SelectedMaTui" class="text-danger d-block mb-2"></span>

            @* danh sách sản phẩm đã chọn ở giỏ; server vẫn đối chiếu lại với giỏ thật trong CSDL *@
            @foreach (var maTui in Model.Checkout.SelectedMaTui)
            {
                <input type="hidden" name="Checkout.SelectedMaTui" value="@maTui" />
            }

            <h2>Thông tin người nhận</h2>
            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <label asp-for="Checkout.TenNguoiNhan" class="form-label"></label>
                    <input asp-for="Checkout.TenNguoiNhan" class="form-control" />
                    <span asp-validation-for="Checkout.TenNguoiNhan" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Checkout.SdtNguoiNhan" class="form-label"></label>
                    <input asp-for="Checkout.SdtNguoiNhan" class="form-control" inputmode="tel" placeholder="0xxxxxxxxx" />
                    <span asp-validation-for="Checkout.SdtNguoiNhan" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold mb-0">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>Chọn vị trí trên bản đồ:
                    </label>
                    <button type="button" id="btnViTriHienTai" class="btn btn-sm btn-outline-dark py-0 px-2" style="font-size: 0.8rem;">
                        <i class="bi bi-crosshair me-1"></i>Vị trí của tôi
                    </button>
                </div>
                <div id="map" style="height: 250px; width: 100%; border-radius: 10px; z-index: 1;" class="border shadow-sm mb-1"></div>
            </div>
            <div class="mb-3">
                <label asp-for="Checkout.DiaChiNhan" class="form-label"></label>
                <textarea asp-for="Checkout.DiaChiNhan" class="form-control" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
                <span asp-validation-for="Checkout.DiaChiNhan" class="text-danger"></span>
            </div>

            <h2>Phương thức thanh toán</h2>
            <div class="mb-3">
                @foreach (var method in PaymentMethod.Labels)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Checkout.PhuongThucThanhToan"
                               value="@method.Key" id="payment-@method.Key" />
                        <label class="form-check-label" for="payment-@method.Key">@method.Value</label>
                    </div>
                }
                <span asp-validation-for="Checkout.PhuongThucThanhToan" class="text-danger"></span>
                <p class="small text-secondary mt-1 mb-0">Chọn chuyển khoản: shop sẽ liên hệ gửi thông tin tài khoản sau khi duyệt đơn.</p>
            </div>

            <div class="mb-3">
                <label asp-for="Checkout.GhiChu" class="form-label"></label>
                <textarea asp-for="Checkout.GhiChu" class="form-control" rows="2" placeholder="Ví dụ: giao giờ hành chính, gói quà..."></textarea>
                <span asp-validation-for="Checkout.GhiChu" class="text-danger"></span>
            </div>

            <p class="checkout-note">Bạn có thể hủy đơn khi đơn còn ở trạng thái <strong>@OrderStatus.ChoDuyet</strong>.</p>
            <button type="submit" class="btn btn-dark">Đặt hàng</button>
        </div>
        <aside class="order-summary">
            <h2>Sản phẩm đã chọn (@Model.Cart.TongSoLuong)</h2>
            @foreach (var item in Model.Cart.Items)
            {
                <div class="summary-line"><span>@item.TenTui × @item.SoLuong</span><strong>@item.ThanhTien.ToString("N0") đ</strong></div>
            }
            <hr />
            @if (Model.IsVip)
            {
                var giamGiaVip = Math.Round(Model.Cart.TongTien * 0.05m);
                var tongSauGiam = Model.Cart.TongTien - giamGiaVip;
                <div class="summary-line text-success mb-2">
                    <span><i class="bi bi-star-fill text-warning me-1"></i>Ưu đãi VIP (-5%)</span>
                    <strong>-@giamGiaVip.ToString("N0") đ</strong>
                </div>
                <div class="summary-total">
                    <span>Tổng thanh toán</span>
                    <strong class="text-danger">@tongSauGiam.ToString("N0") đ</strong>
                </div>
            }
            else
            {
                <div class="summary-total">
                    <span>Tổng thanh toán</span>
                    <strong>@Model.Cart.TongTien.ToString("N0") đ</strong>
                </div>
            }
        </aside>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="~/js/map.js" asp-append-version="true"></script>
}
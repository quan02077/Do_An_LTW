@model IReadOnlyCollection<DoAnLTW.ViewModels.OrderViewModel>
@using DoAnLTW.Services
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<section class="shop-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">TÀI KHOẢN</p>
            <h1>Lịch sử đơn hàng</h1>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark">Xem giỏ hàng</a>
    </div>

    @if (TempData["OrderSuccess"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["OrderError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>Bạn chưa có đơn hàng nào</h2>
            <p>Các đơn đã đặt sẽ được hiển thị tại đây.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <article class="order-card">
                    <header class="order-card-header">
                        <div>
                            <span class="eyebrow">ĐƠN #@order.MaDonHang.ToString()[..8].ToUpperInvariant()</span>
                            <p class="mb-0">@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <span class="status-badge @(order.TrangThai == OrderStatus.DaHuy ? "status-cancelled" : "")">@order.TrangThai</span>
                    </header>
                    <div class="order-card-body">
                        @foreach (var item in order.Items)
                        {
                            <div class="order-line"><span>@item.TenTui × @item.SoLuong</span><strong>@item.ThanhTien.ToString("N0") đ</strong></div>
                        }
                    </div>
                    <footer class="order-card-footer">
                        <span>Giao đến: @order.DiaChiNhan</span>
                        <strong>Tổng: @order.TongTien.ToString("N0") đ</strong>
                        @if (order.TrangThai == OrderStatus.ChoDuyet)
                        {
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">
                                <input type="hidden" name="maDh" value="@order.MaDonHang" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                            </form>
                        }
                    </footer>
                </article>
            }
        </div>
    }
</section>

@model IReadOnlyCollection<DoAnLTW.ViewModels.OrderViewModel>
@using DoAnLTW.Constants
@using DoAnLTW.Services
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<section class="shop-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">TÀI KHOẢN</p>
            <h1>Lịch sử đơn hàng</h1>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark">Xem giỏ hàng</a>
    </div>

    @if (TempData[AppConstants.TempDataKeys.OrderSuccess] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData[AppConstants.TempDataKeys.OrderError] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>Bạn chưa có đơn hàng nào</h2>
            <p>Các đơn hàng đã đặt sẽ được hiển thị tại đây.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <article class="order-card">
                    <header class="order-card-header">
                        <div>
                            <span class="eyebrow">ĐƠN #@order.MaHienThi</span>
                            <p class="mb-0">@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <span class="status-badge @(order.TrangThai == OrderStatus.DaHuy ? "status-cancelled" : "")">@order.TrangThai</span>
                    </header>
                    @if (order.TrangThai == OrderStatus.DaHuy)
                    {
                        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center my-3 rounded-3" role="alert">
                            <i class="bi bi-x-circle-fill me-2 fs-5"></i>
                            <span>Đơn hàng này đã bị hủy. Số lượng sản phẩm đã được hoàn trả lại tồn kho.</span>
                        </div>
                    }
                    else
                    {
                        int step = order.TrangThai switch
                        {
                            OrderStatus.ChoDuyet => 1,
                            OrderStatus.DangGiao => 2,
                            OrderStatus.HoanTat => 3,
                            _ => 1
                        };
                        string progressWidth = step switch
                        {
                            1 => "calc(66.6667% * 0)",
                            2 => "calc(66.6667% * 0.5)",
                            3 => "calc(66.6667% * 1)",
                            _ => "calc(66.6667% * 0)"
                        };

                        <div class="stepper-container">
                            <div class="stepper-progress-bar" style="width: @progressWidth;"></div>
                            <div class="stepper-step @(step > 1 ? "completed" : "active")">
                                <div class="stepper-circle">
                                    <i class="bi @(step > 1 ? "bi-check-lg" : "bi-receipt")"></i>
                                </div>
                                <div class="stepper-label">Đã đặt hàng</div>
                            </div>
                            <div class="stepper-step @(step > 2 ? "completed" : (step == 2 ? "active" : ""))">
                                <div class="stepper-circle">
                                    <i class="bi @(step > 2 ? "bi-check-lg" : "bi-truck")"></i>
                                </div>
                                <div class="stepper-label">Đang giao hàng</div>
                            </div>
                            <div class="stepper-step @(step == 3 ? "completed" : "")">
                                <div class="stepper-circle">
                                    <i class="bi bi-box2-heart"></i>
                                </div>
                                <div class="stepper-label">Đã nhận hàng</div>
                            </div>
                        </div>
                    }
                    <div class="order-card-body">
                        @foreach (var item in order.Items)
                        {
                            <div class="order-line"><span>@item.TenTui × @item.SoLuong</span><strong>@item.ThanhTien.ToString("N0") đ</strong></div>
                        }
                    </div>
                    <div class="order-card-body small text-secondary pt-0">
                        <div>Người nhận: <strong>@order.TenNguoiNhan</strong> · @order.SdtNguoiNhan</div>
                        <div>Thanh toán: @PaymentMethod.GetLabel(order.PhuongThucThanhToan)</div>
                        @if (!string.IsNullOrWhiteSpace(order.GhiChu))
                        {
                            <div>Ghi chú: @order.GhiChu</div>
                        }
                    </div>
                    <footer class="order-card-footer">
                        <span>Giao đến: @order.DiaChiNhan</span>
                        <strong>Tổng: @order.TongTien.ToString("N0") đ</strong>
                        @if (order.TrangThai == OrderStatus.ChoDuyet)
                        {
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maDh" value="@order.MaDonHang" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                            </form>
                        }
                    </footer>
                </article>
            }
        </div>
    }
</section>

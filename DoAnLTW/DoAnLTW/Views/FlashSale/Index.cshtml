@model DoAnLTW.ViewModels.FlashSaleIndexViewModel
@{
    ViewData["Title"] = "Chương Trình Khuyến Mãi Túi Xách & Balo";
    string ResolveImage(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return Url.Content("~/HinhAnh/tui1_1.png");
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || path.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) return path;
        if (path.StartsWith("~")) return Url.Content(path);
        if (path.StartsWith("/")) return Url.Content("~" + path);
        return Url.Content("~/HinhAnh/" + path);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/flashSale.css" asp-append-version="true" />
}

<main class="site-main">
    <!-- banner đầu trang khuyến mãi -->
    <section class="container-fluid bg-black text-white py-5 px-4 px-md-5 text-center">
        <h1 class="oswald-font display-5 fw-bold mb-2 text-white">CHƯƠNG TRÌNH KHUYẾN MÃI TÚI XÁCH</h1>
        <p class="fs-5 mb-0 text-white-50">Áp dụng cho các dòng túi xách, balo chính hãng với ưu đãi đặc biệt</p>
    </section>

    <!-- danh sách các chiến dịch khuyến mãi đang chạy -->
    <section class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-secondary small fw-bold text-uppercase">Bấm vào chiến dịch để lọc sản phẩm:</span>
            @if (Model.SelectedKmId.HasValue && Model.SelectedKmId.Value > 0)
            {
                <a asp-controller="FlashSale" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
                    ✕ Xem tất cả khuyến mãi
                </a>
            }
        </div>
        <div class="row g-3">
            @foreach (var km in Model.Campaigns)
            {
                var isSelected = Model.SelectedKmId == km.maKM;
                <div class="col-md-3 col-6">
                    <a asp-controller="FlashSale" asp-action="Index" asp-route-kmId="@(isSelected ? null : km.maKM)" class="text-decoration-none text-dark d-block h-100">
                        <div class="promo-campaign-card p-3 bg-white border @(isSelected ? "border-danger border-2 shadow" : "shadow-sm") rounded-3 text-center h-100" style="transition: all 0.25s;">
                            <span class="badge bg-danger mb-1">-@km.phanTramGiam.ToString("0")%</span>
                            <div class="fw-bold mb-1 text-truncate" title="@km.tenKM">@km.tenKM</div>
                            <small class="text-muted">@km.ngayBatDau.ToString("dd/MM") - @km.ngayKetThuc.ToString("dd/MM/yyyy")</small>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- lưới sản phẩm đang áp dụng khuyến mãi -->
    <section class="container my-5 bg-white p-4 p-md-5 rounded-4 border shadow-sm">
        <div class="mb-4 pb-2 border-bottom d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <h2 class="fw-bold oswald-font mb-1" style="font-size: 1.8rem; line-height: 1.4;">DANH SÁCH TÚI XÁCH ĐANG KHUYẾN MÃI</h2>
                <p class="text-secondary small mb-0">Các sản phẩm đang áp dụng mã giảm giá theo chiến dịch</p>
            </div>
            <span class="badge bg-dark px-3 py-2">@Model.Products.Count sản phẩm</span>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="text-center py-5">
                <p class="text-secondary">Hiện tại chưa có sản phẩm nào thuộc chương trình khuyến mãi này.</p>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-bold">Xem tất cả túi xách</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model.Products)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="product-card border p-3 shadow-sm h-100 d-flex flex-column position-relative">
                            <a asp-controller="Catalog" asp-action="Detail" asp-route-id="@p.MaTui" class="text-decoration-none text-dark d-block">
                                <div class="product-img-wrap mb-3 text-center" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                                    <img src="@ResolveImage(p.HinhAnh)" alt="@p.TenTui" class="img-fluid" style="max-height: 180px; object-fit: contain;">
                                </div>
                            </a>

                            @if (p.PhanTramGiam > 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2 py-1">-@p.PhanTramGiam.ToString("0")%</span>
                            }

                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-secondary small fw-bold text-uppercase">@p.TenThuongHieu</span>
                                <span class="badge bg-light text-dark border">Còn @p.SoLuongTonKho</span>
                            </div>

                            <a asp-controller="Catalog" asp-action="Detail" asp-route-id="@p.MaTui" class="text-decoration-none text-dark">
                                <h6 class="fw-bold mb-1 text-truncate" title="@p.TenTui">@p.TenTui</h6>
                            </a>

                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex align-items-baseline mb-2">
                                    <span class="text-muted text-decoration-line-through small me-2">@p.DonGiaGoc.ToString("N0") ₫</span>
                                    <span class="text-danger fw-bold">@p.DonGiaHienTai.ToString("N0") ₫</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Catalog" asp-action="Detail" asp-route-id="@p.MaTui" class="btn btn-outline-dark rounded-pill fw-bold py-1 flex-grow-1 text-center small">
                                        Chi tiết
                                    </a>
                                    @if (p.SoLuongTonKho > 0)
                                    {
                                        <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MaTui" value="@p.MaTui" />
                                            <input type="hidden" name="SoLuong" value="1" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="btn btn-dark rounded-pill fw-bold py-1 px-3 small">Thêm</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</main>

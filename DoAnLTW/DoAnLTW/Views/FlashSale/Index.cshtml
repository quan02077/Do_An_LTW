@{
    ViewData["Title"] = "Chương Trình Khuyến Mãi Túi Xách & Balo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/flashSale.css" asp-append-version="true" />
}

<main class="site-main">
    <!-- Banner Đầu Trang Khuyến Mãi -->
    <section class="container-fluid bg-black text-white py-5 px-4 px-md-5 text-center">
        <h1 class="oswald-font display-5 fw-bold mb-2 text-white">CHƯƠNG TRÌNH KHUYẾN MÃI TÚI XÁCH</h1>
        <p class="fs-5 mb-0 text-white-50">Áp dụng cho các dòng túi xách, balo chính hãng với ưu đãi lên tới 30%</p>
    </section>

    <!-- Danh Sách Các Chiến Dịch Khuyến Mãi Đang Chạy -->
    <section class="container mt-4">
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white border rounded-3 shadow-sm text-center">
                    <span class="badge bg-danger mb-1">-10%</span>
                    <div class="fw-bold mb-1">Khuyến mãi tháng 9</div>
                    <small class="text-muted">01/09 - 30/09</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white border rounded-3 shadow-sm text-center">
                    <span class="badge bg-danger mb-1">-15%</span>
                    <div class="fw-bold mb-1">Sale cuối tuần</div>
                    <small class="text-muted">05/09 - 30/09</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white border rounded-3 shadow-sm text-center">
                    <span class="badge bg-danger mb-1">-20%</span>
                    <div class="fw-bold mb-1">Ưu đãi khách hàng mới</div>
                    <small class="text-muted">01/09 - 31/12</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-white border rounded-3 shadow-sm text-center">
                    <span class="badge bg-danger mb-1">-25%</span>
                    <div class="fw-bold mb-1">Sale mùa thu</div>
                    <small class="text-muted">15/09 - 15/10</small>
                </div>
            </div>
        </div>
    </section>

    <!-- Lưới Sản Phẩm Đang Áp Dụng Khuyến Mãi -->
    <section class="container my-5 bg-white p-4 p-md-5 rounded-4 border shadow-sm">
        <div class="mb-4 pb-2 border-bottom">
            <h2 class="fw-bold oswald-font mb-1" style="font-size: 1.8rem; line-height: 1.4;">DANH SÁCH TÚI XÁCH ĐANG KHUYẾN MÃI</h2>
            <p class="text-secondary small mb-0">Các sản phẩm đang áp dụng mã giảm giá theo chiến dịch</p>
        </div>

        <div class="row g-4" id="flashSaleRow">
            <!-- Nạp động từ script -->
        </div>
    </section>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/data.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('flashSaleRow');
            if (!container) return;

            let prods = (typeof getAllProducts === 'function') ? getAllProducts() : (typeof productsDatabase !== 'undefined' ? productsDatabase : []);
            let saleProds = prods.filter(p => (p.makm && p.makm > 0) || (p.discountPercent && p.discountPercent > 0));

            if (saleProds.length === 0) {
                container.innerHTML = '<div class="col-12 text-center py-5 text-muted">Hiện chưa có chương trình khuyến mãi nào được áp dụng.</div>';
                return;
            }

            let html = '';
            saleProds.forEach(p => {
                let disc = p.discountPercent || (p.makm === 1 ? 10 : p.makm === 2 ? 15 : p.makm === 3 ? 20 : p.makm === 4 ? 25 : 30);
                let oldP = p.oldPrice || Math.round(p.price / (1 - disc / 100));

                html += `
                    <div class="col-6 col-md-3">
                        <a href="/Catalog/Detail?id=${p.id}" class="text-decoration-none text-dark">
                            <div class="flash-sale-card bg-white p-3 rounded-4 border shadow-sm h-100 d-flex flex-column position-relative">
                                <div class="sale-badge position-absolute top-0 end-0 m-2">-${disc}%</div>
                                <div class="img-wrap mb-3 d-flex align-items-center justify-content-center bg-light rounded-3" style="height: 180px; overflow: hidden;">
                                    <img src="${p.img}" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="${p.name}">
                                </div>
                                <span class="category-text text-secondary small fw-bold text-uppercase mb-1">${p.brand} · ${p.category}</span>
                                <h5 class="card-name fw-bold mb-1" style="font-size: 15px; min-height: 44px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; line-height: 1.45;">${p.name}</h5>
                                <div class="small text-success fw-bold mb-2">${p.promotionName || 'Đang giảm giá'}</div>
                                <div class="price-container mt-auto mb-3">
                                    <span class="price-original text-muted text-decoration-line-through me-2">${oldP.toLocaleString('vi-VN')} ₫</span>
                                    <span class="price-sale text-danger fw-bold fs-5">${p.price.toLocaleString('vi-VN')} ₫</span>
                                </div>
                                <button class="btn btn-dark w-100 fw-bold rounded-pill py-2">XEM CHI TIẾT</button>
                            </div>
                        </a>
                    </div>
                `;
            });
            container.innerHTML = html;
        });
    </script>
}

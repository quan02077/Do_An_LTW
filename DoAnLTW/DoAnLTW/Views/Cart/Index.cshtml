@model DoAnLTW.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<section class="shop-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">MUA SẮM</p>
            <h1>Giỏ hàng của bạn</h1>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Tiếp tục mua sắm</a>
    </div>

    @if (TempData["CartSuccess"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["CartError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h2>Giỏ hàng đang trống</h2>
            <p>Hãy chọn một mẫu túi phù hợp rồi quay lại đây để thanh toán.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Model.Items)
                {
                    <article class="cart-item">
                        @if (!string.IsNullOrWhiteSpace(item.Anh))
                        {
                            <img src="@item.Anh" alt="@item.TenTui" class="cart-product-image" />
                        }
                        else
                        {
                            <div class="cart-product-image image-placeholder">Không có ảnh</div>
                        }
                        <div class="cart-item-info">
                            <h2>@item.TenTui</h2>
                            <p class="price">@item.DonGia.ToString("N0") đ</p>
                        </div>
                        <form asp-action="Update" method="post" class="quantity-form">
                            <input type="hidden" name="maTui" value="@item.MaTui" />
                            <label class="visually-hidden" for="quantity-@item.MaTui">Số lượng</label>
                            <input id="quantity-@item.MaTui" name="SoLuong" type="number" min="1" max="99" value="@item.SoLuong" class="form-control" />
                            <button class="btn btn-sm btn-outline-dark" type="submit">Cập nhật</button>
                        </form>
                        <strong class="item-total">@item.ThanhTien.ToString("N0") đ</strong>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="maTui" value="@item.MaTui" />
                            <button class="btn btn-link link-danger p-0" type="submit">Xóa</button>
                        </form>
                    </article>
                }
            </div>
            <aside class="order-summary">
                <h2>Tóm tắt đơn hàng</h2>
                <div><span>Sản phẩm (@Model.TongSoLuong)</span><strong>@Model.TongTien.ToString("N0") đ</strong></div>
                <div><span>Vận chuyển</span><span>Tính khi đặt hàng</span></div>
                <hr />
                <div class="summary-total"><span>Tạm tính</span><strong>@Model.TongTien.ToString("N0") đ</strong></div>
                <a asp-controller="Orders" asp-action="Checkout" class="btn btn-dark w-100 mt-4">Tiến hành thanh toán</a>
            </aside>
        </div>
    }
</section>

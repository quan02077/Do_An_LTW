@model DoAnLTW.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<section class="shop-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">MUA SẮM</p>
            <h1>Giỏ hàng của bạn</h1>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Tiếp tục mua sắm</a>
    </div>

    @if (TempData["CartSuccess"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["CartError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h2>Giỏ hàng đang trống</h2>
            <p>Hãy chọn một mẫu túi phù hợp rồi quay lại đây để thanh toán.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                <div class="form-check px-3 pt-3">
                    <input class="form-check-input ms-0 me-2" type="checkbox" id="selectAll" checked />
                    <label class="form-check-label fw-semibold" for="selectAll">Chọn tất cả (@Model.Items.Count sản phẩm)</label>
                </div>

                @foreach (var item in Model.Items)
                {
                    <article class="cart-item">
                        @if (!string.IsNullOrWhiteSpace(item.Anh))
                        {
                            <img src="~/HinhAnh/@item.Anh" alt="@item.TenTui" class="cart-product-image" />
                        }
                        else
                        {
                            <div class="cart-product-image image-placeholder">Không có ảnh</div>
                        }
                        <div class="cart-item-info">
                            <!-- ô chọn thuộc form thanh toán bên dưới (thuộc tính form=) vì HTML không cho lồng form -->
                            <div class="form-check mb-1">
                                <input class="form-check-input cart-select" type="checkbox" form="checkoutForm"
                                       name="selected" value="@item.MaTui" id="select-@item.MaTui" checked
                                       data-qty="@item.SoLuong" data-total="@item.ThanhTien.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <label class="form-check-label small text-secondary" for="select-@item.MaTui">Chọn mua</label>
                            </div>
                            <h2>@item.TenTui</h2>
                            <p class="price">@item.DonGia.ToString("N0") đ</p>
                        </div>
                        <form asp-action="Update" method="post" class="quantity-form">
                            <input type="hidden" name="maTui" value="@item.MaTui" />
                            <label class="visually-hidden" for="quantity-@item.MaTui">Số lượng</label>
                            <input id="quantity-@item.MaTui" name="SoLuong" type="number" min="1" max="99" value="@item.SoLuong" class="form-control" />
                            <button class="btn btn-sm btn-outline-dark" type="submit">Cập nhật</button>
                        </form>
                        <strong class="item-total">@item.ThanhTien.ToString("N0") đ</strong>
                        <form asp-action="Remove" method="post" onsubmit="return confirm('Xóa sản phẩm này khỏi giỏ hàng?');">
                            <input type="hidden" name="maTui" value="@item.MaTui" />
                            <button class="btn btn-link link-danger p-0" type="submit">Xóa</button>
                        </form>
                    </article>
                }
            </div>
            <aside class="order-summary">
                <h2>Tóm tắt đơn hàng</h2>
                <div><span>Trong giỏ (@Model.TongSoLuong)</span><span>@Model.TongTien.ToString("N0") đ</span></div>
                <div><span>Đã chọn (<span id="selectedQty">@Model.TongSoLuong</span>)</span><strong id="selectedTotal">@Model.TongTien.ToString("N0") đ</strong></div>
                <div><span>Vận chuyển</span><span>Tính khi đặt hàng</span></div>
                <hr />
                <div class="summary-total"><span>Tạm tính</span><strong id="selectedTotal2">@Model.TongTien.ToString("N0") đ</strong></div>
                <!-- GET: chỉ chuyển danh sách sản phẩm đã chọn sang trang xác nhận, chưa ghi gì vào CSDL -->
                <form id="checkoutForm" asp-controller="Orders" asp-action="Checkout" method="get">
                    <button id="checkoutButton" type="submit" class="btn btn-dark w-100 mt-4">Thanh toán sản phẩm đã chọn</button>
                </form>
                <p class="small text-secondary mt-2 mb-0">Sản phẩm không được chọn vẫn được giữ lại trong giỏ.</p>
            </aside>
        </div>
    }
</section>

@section Scripts {
    <script>
        // cập nhật tạm tính theo các sản phẩm được tick (chỉ để hiển thị; server luôn tính lại khi đặt hàng)
        (function () {
            const boxes = Array.from(document.querySelectorAll('.cart-select'));
            const selectAll = document.getElementById('selectAll');
            if (!boxes.length || !selectAll) return;
            const fmt = new Intl.NumberFormat('vi-VN');

            function refresh() {
                const checked = boxes.filter(b => b.checked);
                const qty = checked.reduce((s, b) => s + Number(b.dataset.qty), 0);
                const total = checked.reduce((s, b) => s + Number(b.dataset.total), 0);
                document.getElementById('selectedQty').textContent = qty;
                document.getElementById('selectedTotal').textContent = fmt.format(total) + ' đ';
                document.getElementById('selectedTotal2').textContent = fmt.format(total) + ' đ';
                document.getElementById('checkoutButton').disabled = checked.length === 0;
                selectAll.checked = checked.length === boxes.length;
            }

            boxes.forEach(b => b.addEventListener('change', refresh));
            selectAll.addEventListener('change', () => { boxes.forEach(b => b.checked = selectAll.checked); refresh(); });
            refresh();
        })();
    </script>
}

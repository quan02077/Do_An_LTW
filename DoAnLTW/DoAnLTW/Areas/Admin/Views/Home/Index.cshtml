@model DoAnLTW.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<div class="main-content-wrap">
    <!-- Tieu de trang -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">Tổng Quan Cửa Hàng</h3>
            <p class="text-muted small mb-0">Thống kê dữ liệu thực tế từ hệ thống quản lý túi xách Basau Bags</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/Products/Create" class="btn btn-dark rounded-0 px-3 fw-semibold">+ Thêm sản phẩm</a>
            <a href="/Admin/Orders" class="btn btn-outline-dark rounded-0 px-3 fw-semibold">Xem đơn hàng</a>
        </div>
    </div>

    <!-- The thong ke tong quan -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="wg-box p-3 h-100 border">
                <div class="text-muted small fw-bold text-uppercase mb-1">Tổng đơn hàng</div>
                <h3 class="fw-bold text-dark mb-1">@Model.TotalOrders</h3>
                <div class="small text-muted">@Model.DeliveredOrders đơn hoàn thành</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="wg-box p-3 h-100 border">
                <div class="text-muted small fw-bold text-uppercase mb-1">Doanh thu đã thu</div>
                <h3 class="fw-bold text-success mb-1">@Model.TotalRevenue.ToString("N0") đ</h3>
                <div class="small text-muted">Từ các đơn đã giao thành công</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="wg-box p-3 h-100 border">
                <div class="text-muted small fw-bold text-uppercase mb-1">Đơn đang xử lý / giao</div>
                <h3 class="fw-bold text-warning mb-1">@Model.PendingOrders</h3>
                <div class="small text-muted">Tiền chờ: @Model.PendingAmount.ToString("N0") đ</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="wg-box p-3 h-100 border">
                <div class="text-muted small fw-bold text-uppercase mb-1">Kho túi xách</div>
                <h3 class="fw-bold text-primary mb-1">@Model.TotalProducts</h3>
                <div class="small text-muted">@Model.TotalCategories loại túi • @Model.TotalBrands hãng</div>
            </div>
        </div>
    </div>

    <!-- Bang don hang gan day -->
    <div class="wg-box">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h5 class="fw-bold mb-0">Đơn Hàng Gần Đây</h5>
            <a href="/Admin/Orders" class="btn btn-outline-dark btn-sm rounded-0">Xem tất cả đơn hàng →</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle border mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Ngày đặt</th>
                        <th class="text-center">Số món</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-end" style="width: 100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng nào trong hệ thống.</td>
                        </tr>
                    }
                    @foreach (var o in Model.RecentOrders)
                    {
                        string badgeClass = o.trangThai switch
                        {
                            "Đã giao" => "bg-success",
                            "Đang giao" => "bg-primary",
                            "Đã hủy" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td class="fw-bold">@o.MaHienThi</td>
                            <td class="fw-semibold text-dark">@(o.KhachHang?.hoTen ?? "Khách vãng lai")</td>
                            <td class="small text-muted">@(o.KhachHang?.sdt ?? "---")</td>
                            <td class="small text-muted">@o.ngayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center fw-bold">@o.ChiTietDonHangs.Sum(ct => ct.soLuong)</td>
                            <td class="text-end fw-bold text-danger">@o.tongTien.ToString("N0") đ</td>
                            <td class="text-center">
                                <span class="badge @badgeClass rounded-0 px-2 py-1">@o.trangThai</span>
                            </td>
                            <td class="text-end">
                                <a href="/Admin/Orders/Details/@o.maDH" class="btn btn-outline-dark btn-sm rounded-0">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model DoAnLTW.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="main-content-wrap">
    <!-- KHỐI: CÁC THẺ THỐNG KÊ (BÊN TRÁI) VÀ BIỂU ĐỒ TRÒN TRẠNG THÁI ĐƠN HÀNG (BÊN PHẢI) -->
    <div class="tf-section-2 mb-30">
        <div class="flex gap20 flex-wrap-mobile">
            <!-- Cột thống kê 1 (Trái) -->
            <div class="w-half">
                <!-- Tổng đơn hàng -->
                <div class="wg-chart-default mb-20">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap14">
                            <div class="image ic-bg"><i class="icon-shopping-bag"></i></div>
                            <div>
                                <div class="body-text mb-2">Total Orders</div>
                                <h4>@Model.TongDonHang</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Đơn chờ duyệt -->
                <div class="wg-chart-default mb-20">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap14">
                            <div class="image ic-bg"><i class="icon-clock"></i></div>
                            <div>
                                <div class="body-text mb-2">Pending Orders</div>
                                <h4>@Model.DonChoDuyet</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Đơn đang giao -->
                <div class="wg-chart-default">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap14">
                            <div class="image ic-bg"><i class="icon-truck"></i></div>
                            <div>
                                <div class="body-text mb-2">Delivering Orders</div>
                                <h4>@Model.DonDangGiao</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột thống kê 2 (Phải) -->
            <div class="w-half">
                <!-- Tổng doanh thu thực tế -->
                <div class="wg-chart-default mb-20">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap14">
                            <div class="image ic-bg"><i class="icon-dollar-sign"></i></div>
                            <div>
                                <div class="body-text mb-2">Total Revenue</div>
                                <h4>@Model.TongDoanhThu.ToString("N0") ₫</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Đơn hoàn tất -->
                <div class="wg-chart-default mb-20">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap14">
                            <div class="image ic-bg"><i class="icon-check-circle"></i></div>
                            <div>
                                <div class="body-text mb-2">Completed Orders</div>
                                <h4>@Model.DonHoanTat</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Đơn đã hủy -->
                <div class="wg-chart-default">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap14">
                            <div class="image ic-bg"><i class="icon-x-circle"></i></div>
                            <div>
                                <div class="body-text mb-2">Canceled Orders</div>
                                <h4>@Model.DonDaHuy</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ Pie Chart tỷ lệ trạng thái đơn hàng bên phải -->
        <div class="wg-box">
            <div class="flex items-center justify-between mb-20">
                <h5>Tỷ lệ trạng thái đơn hàng</h5>
                <span class="body-text text-muted">Thống kê đơn hàng</span>
            </div>
            <div class="flex flex-wrap gap40 mb-20">
                <div>
                    <div class="mb-2">
                        <div class="block-legend">
                            <div class="dot t1"></div>
                            <div class="text-tiny">Tổng đơn hàng</div>
                        </div>
                    </div>
                    <div class="flex items-center gap10">
                        <h4>@Model.TongDonHang</h4>
                    </div>
                </div>
                <div>
                    <div class="mb-2">
                        <div class="block-legend">
                            <div class="dot t2"></div>
                            <div class="text-tiny">Tỷ lệ hoàn tất</div>
                        </div>
                    </div>
                    <div class="flex items-center gap10">
                        <h4>@(Model.TongDonHang > 0 ? $"{(Model.DonHoanTat * 100 / Model.TongDonHang)}%" : "0%")</h4>
                    </div>
                </div>
            </div>
            <div id="order-status-pie-chart"></div>
        </div>
    </div>

    <div class="wg-box mb-30">
        <div class="flex items-center justify-between mb-20">
            <h5>Doanh thu theo tháng</h5>
            <form method="get" asp-area="Admin" asp-controller="Home" asp-action="Index">
                <label for="revenue-year">Năm</label>
                <select id="revenue-year" name="year" onchange="this.form.submit()">
                    @foreach (var year in Model.DanhSachNam)
                    {
                        <option value="@year" selected="@(year == Model.NamDuocChon)">@year</option>
                    }
                </select>
            </form>
        </div>
        <div id="monthly-revenue-chart"></div>
    </div>

    <div class="wg-box">
        <h5 class="mb-20">Top 5 sản phẩm bán chạy</h5>
        @if (Model.SanPhamBanChay.Count == 0)
        {
            <p>Chưa có sản phẩm bán ra từ đơn hoàn tất.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Tên túi</th><th>Số lượng đã bán</th><th>Doanh thu</th></tr></thead>
                    <tbody>
                        @foreach (var product in Model.SanPhamBanChay)
                        {
                            <tr><td>@product.TenTui</td><td>@product.SoLuongDaBan</td><td>@product.DoanhThu.ToString("N0") ₫</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var seriesData = [@Model.DonChoDuyet, @Model.DonDangGiao, @Model.DonHoanTat, @Model.DonDaHuy];
            var totalOrders = @Model.TongDonHang;

            var options = {
                series: totalOrders > 0 ? seriesData : [],
                labels: @Json.Serialize(OrderStatus.All),
                chart: {
                    type: 'donut',
                    height: 320
                },
                colors: ['#ffb800', '#2275fc', '#20c997', '#dc3545'],
                noData: {
                    text: 'Chưa có dữ liệu đơn hàng',
                    align: 'center',
                    verticalAlign: 'middle',
                    style: {
                        color: '#888',
                        fontSize: '14px'
                    }
                },
                legend: {
                    position: 'bottom',
                    fontSize: '13px',
                    markers: {
                        radius: 12
                    }
                },
                dataLabels: {
                    enabled: totalOrders > 0,
                    formatter: function (val) {
                        return val.toFixed(1) + "%";
                    }
                },
                tooltip: {
                    y: {
                        formatter: function (val) {
                            return val + " đơn hàng";
                        }
                    }
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Tổng đơn',
                                    formatter: function () {
                                        return totalOrders;
                                    }
                                }
                            }
                        }
                    }
                },
                responsive: [{
                    breakpoint: 480,
                    options: {
                        chart: {
                            width: 260
                        },
                        legend: {
                            position: 'bottom'
                        }
                    }
                }]
            };

            var chart = new ApexCharts(document.querySelector("#order-status-pie-chart"), options);
            chart.render();

            var revenueChart = new ApexCharts(document.querySelector("#monthly-revenue-chart"), {
                chart: { type: 'bar', height: 320 },
                series: [{ name: 'Doanh thu', data: @Json.Serialize(Model.DoanhThuTheoThang) }],
                xaxis: { categories: @Json.Serialize(Enumerable.Range(1, 12).Select(month => $"Tháng {month}")) },
                yaxis: { labels: { formatter: function (value) { return value.toLocaleString('vi-VN'); } } },
                tooltip: { y: { formatter: function (value) { return value.toLocaleString('vi-VN') + ' ₫'; } } }
            });
            revenueChart.render();
        });
    </script>
}

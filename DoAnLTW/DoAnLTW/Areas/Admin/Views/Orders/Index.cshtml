@model List<DoAnLTW.Models.DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    string currentStatus = ViewBag.CurrentStatus as string ?? "All";
}

<div class="main-content-wrap">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold mb-1">Quản lý Đơn Hàng</h3>
            <p class="text-muted small mb-0">Theo dõi, duyệt và cập nhật tiến trình giao hàng</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-0 shadow-sm" role="alert">
            <strong>Thành công!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-0 shadow-sm" role="alert">
            <strong>Lỗi!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabs trang thai & Tim kiem -->
    <div class="wg-box mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="btn-group rounded-0" role="group">
                <a asp-action="Index" asp-route-status="All" class="btn btn-sm rounded-0 @(currentStatus == "All" ? "btn-dark" : "btn-outline-secondary")">Tất cả (@Model.Count)</a>
                <a asp-action="Index" asp-route-status="Chờ xử lý" class="btn btn-sm rounded-0 @(currentStatus == "Chờ xử lý" ? "btn-dark" : "btn-outline-secondary")">Chờ xử lý</a>
                <a asp-action="Index" asp-route-status="Đang giao" class="btn btn-sm rounded-0 @(currentStatus == "Đang giao" ? "btn-dark" : "btn-outline-secondary")">Đang giao</a>
                <a asp-action="Index" asp-route-status="Đã giao" class="btn btn-sm rounded-0 @(currentStatus == "Đã giao" ? "btn-dark" : "btn-outline-secondary")">Đã giao</a>
                <a asp-action="Index" asp-route-status="Đã hủy" class="btn btn-sm rounded-0 @(currentStatus == "Đã hủy" ? "btn-dark" : "btn-outline-secondary")">Đã hủy</a>
            </div>

            <form method="get" class="d-flex gap-2">
                <input type="hidden" name="status" value="@currentStatus" />
                <input type="text" name="q" value="@ViewBag.SearchQuery" class="form-control form-control-sm rounded-0" placeholder="Mã đơn, tên khách..." />
                <button type="submit" class="btn btn-dark btn-sm rounded-0 px-3">Tìm</button>
            </form>
        </div>
    </div>

    <!-- Bang danh sach don hang -->
    <div class="wg-box">
        <div class="table-responsive">
            <table class="table table-hover align-middle border mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số ĐT</th>
                        <th>Ngày đặt</th>
                        <th class="text-center">Số món</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-end" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng nào trong mục này.</td>
                        </tr>
                    }
                    @foreach (var o in Model)
                    {
                        string badgeClass = o.trangThai switch
                        {
                            "Đã giao" => "bg-success",
                            "Đang giao" => "bg-primary",
                            "Đã hủy" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td class="fw-bold">@o.MaHienThi</td>
                            <td>
                                <div class="fw-bold text-dark">@(o.KhachHang?.hoTen ?? "Khách vãng lai")</div>
                                <div class="small text-muted text-truncate" style="max-width: 200px;">@o.diaChiNhan</div>
                            </td>
                            <td class="small">@(o.KhachHang?.sdt ?? "---")</td>
                            <td class="small text-muted">@o.ngayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center fw-semibold">@o.ChiTietDonHangs.Sum(ct => ct.soLuong)</td>
                            <td class="text-end fw-bold text-danger">@o.tongTien.ToString("N0") đ</td>
                            <td class="text-center">
                                <span class="badge @badgeClass rounded-0 px-2 py-1">@o.trangThai</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@o.maDH" class="btn btn-outline-dark btn-sm rounded-0">
                                    Chi tiết →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

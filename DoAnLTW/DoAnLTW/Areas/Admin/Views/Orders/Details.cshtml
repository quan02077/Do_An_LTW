@model DoAnLTW.Models.DonHang
@{
    ViewData["Title"] = $"Chi tiết đơn hàng {Model.MaHienThi}";
    string badgeClass = Model.trangThai switch
    {
        "Đã giao" => "bg-success",
        "Đang giao" => "bg-primary",
        "Đã hủy" => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="main-content-wrap">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold mb-1">Chi Tiết Đơn Hàng @Model.MaHienThi</h3>
            <p class="text-muted small mb-0">Ngày đặt: <strong>@Model.ngayDat.ToString("dd/MM/yyyy HH:mm:ss")</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-0 px-3">
            ← Quay lại danh sách
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-0 shadow-sm" role="alert">
            <strong>Thành công!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cot thong tin khach & cap nhat trang thai -->
        <div class="col-lg-4">
            <!-- Thong tin khach hang -->
            <div class="wg-box mb-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3">Thông Tin Người Nhận</h5>
                <p class="mb-1 small"><strong>Họ tên:</strong> @(Model.KhachHang?.hoTen ?? "---")</p>
                <p class="mb-1 small"><strong>Số điện thoại:</strong> @(Model.KhachHang?.sdt ?? "---")</p>
                <p class="mb-1 small"><strong>Email:</strong> @(Model.KhachHang?.email ?? "---")</p>
                <p class="mb-0 small"><strong>Địa chỉ giao:</strong> @Model.diaChiNhan</p>
            </div>

            <!-- Cap nhat trang thai don hang -->
            <div class="wg-box">
                <h5 class="fw-bold border-bottom pb-2 mb-3">Trạng Thái Đơn Hàng</h5>
                <div class="mb-3">
                    <span class="small text-muted">Hiện tại:</span>
                    <span class="badge @badgeClass rounded-0 px-3 py-2 fs-6 d-block text-center mt-1">@Model.trangThai</span>
                </div>

                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDH" value="@Model.maDH" />
                    <label class="form-label small fw-bold text-secondary">Cập nhật sang trạng thái:</label>
                    <select name="trangThai" class="form-select rounded-0 mb-3">
                        <option value="Chờ xử lý" selected="@(Model.trangThai == "Chờ xử lý" ? "selected" : null)">Chờ xử lý</option>
                        <option value="Đang giao" selected="@(Model.trangThai == "Đang giao" ? "selected" : null)">Đang giao hàng</option>
                        <option value="Đã giao" selected="@(Model.trangThai == "Đã giao" ? "selected" : null)">Đã giao (Hoàn thành)</option>
                        <option value="Đã hủy" selected="@(Model.trangThai == "Đã hủy" ? "selected" : null)">Đã hủy</option>
                    </select>
                    <button type="submit" class="btn btn-dark w-100 rounded-0 fw-semibold">
                        Lưu trạng thái mới
                    </button>
                </form>
            </div>
        </div>

        <!-- Cot danh sach san pham trong don -->
        <div class="col-lg-8">
            <div class="wg-box">
                <h5 class="fw-bold border-bottom pb-2 mb-3">Danh Sách Sản Phẩm Đã Mua</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle border mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 70px;">Ảnh</th>
                                <th>Tên túi xách</th>
                                <th class="text-center" style="width: 90px;">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.ChiTietDonHangs)
                            {
                                var anhChinh = ct.TuiXach?.HinhAnhTuis.FirstOrDefault(a => a.laAnhChinh)?.tenHinhAnh 
                                              ?? ct.TuiXach?.HinhAnhTuis.FirstOrDefault()?.tenHinhAnh 
                                              ?? "tui1_1.png";
                                var imgSrc = anhChinh.StartsWith("http") ? anhChinh : $"/HinhAnh/{anhChinh}";

                                <tr>
                                    <td>
                                        <img src="@imgSrc" alt="@ct.TuiXach?.tenTui" class="border" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='/HinhAnh/tui1_1.png';" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@(ct.TuiXach?.tenTui ?? "Sản phẩm")</div>
                                        <div class="small text-muted">Mã: @(ct.TuiXach?.MaHienThi ?? "TX--")</div>
                                    </td>
                                    <td class="text-center fw-bold">@ct.soLuong</td>
                                    <td class="text-end">@ct.donGia.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-danger">@ct.thanhTien.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold fs-6">Tổng thanh toán:</td>
                                <td class="text-end fw-bold fs-5 text-danger">@Model.tongTien.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

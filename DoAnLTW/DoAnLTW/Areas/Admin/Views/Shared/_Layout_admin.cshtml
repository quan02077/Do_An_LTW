<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Quản Trị Hệ Thống") - Basau Bags Admin</title>
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="stylesheet" type="text/css" href="~/css/animate.min.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/animation.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap-select.min.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/font/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/icon/style.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/sweetalert.min.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="body">
    <div id="wrapper">
        <div id="page" class="">
            <div class="layout-wrap">
                <!-- Sidebar Menu Trái -->
                <div class="section-menu-left">
                    <div class="box-logo d-flex align-items-center justify-content-between px-3 py-3 border-bottom">
                        <a href="/Admin" id="site-logo-inner" class="text-decoration-none d-flex align-items-center gap-2">
                            <span class="fs-4 fw-bold text-dark" style="letter-spacing: 1px;">BASAU <span class="text-primary">ADMIN</span></span>
                        </a>
                        <div class="button-show-hide">
                            <i class="icon-menu-left"></i>
                        </div>
                    </div>
                    <div class="center">
                        <div class="center-item">
                            <div class="center-heading">Bảng Điều Khiển</div>
                            <ul class="menu-list">
                                <li class="menu-item active">
                                    <a href="/Admin" class="menu-item-button">
                                        <div class="icon"><i class="icon-grid"></i></div>
                                        <div class="text">Tổng Quan Dashboard</div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="center-item">
                            <div class="center-heading">Quản Lý Cửa Hàng</div>
                            <ul class="menu-list">
                                <li class="menu-item">
                                    <a href="/Admin#products" class="menu-item-button">
                                        <div class="icon"><i class="icon-shopping-bag"></i></div>
                                        <div class="text">Quản Lý Túi Xách</div>
                                    </a>
                                </li>
                                <li class="menu-item">
                                    <a href="/Admin#orders" class="menu-item-button">
                                        <div class="icon"><i class="icon-file-plus"></i></div>
                                        <div class="text">Đơn Đặt Hàng</div>
                                    </a>
                                </li>
                                <li class="menu-item">
                                    <a href="/Admin#stats" class="menu-item-button">
                                        <div class="icon"><i class="icon-layers"></i></div>
                                        <div class="text">Báo Cáo & Thống Kê</div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="center-item">
                            <div class="center-heading">Hệ Thống</div>
                            <ul class="menu-list">
                                <li class="menu-item">
                                    <a href="/" target="_blank" class="menu-item-button">
                                        <div class="icon"><i class="bi bi-box-arrow-up-right"></i></div>
                                        <div class="text">Xem Website (User)</div>
                                    </a>
                                </li>
                                <li class="menu-item">
                                    <a href="/Account/Profile" class="menu-item-button">
                                        <div class="icon"><i class="icon-user"></i></div>
                                        <div class="text">Tài Khoản Admin</div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Nội Dung Chính Phải -->
                <div class="section-content-right">
                    <!-- Header Top Bar -->
                    <div class="header-dashboard">
                        <div class="wrap">
                            <div class="header-left d-flex align-items-center gap-3">
                                <div class="button-show-hide">
                                    <i class="icon-menu-left"></i>
                                </div>
                                <span class="fw-bold fs-5 text-dark d-none d-md-inline">Trang Quản Trị Hệ Thống</span>
                            </div>
                            <div class="header-grid d-flex align-items-center gap-3">
                                <a href="/" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                    <i class="bi bi-arrow-left me-1"></i>Về trang chủ
                                </a>
                                <div class="popup-wrap user type-header">
                                    <div class="dropdown">
                                        <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border rounded-pill px-3 py-1" type="button" id="adminDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-person-circle fs-5"></i>
                                            <span class="fw-bold small">@(User.Identity?.Name ?? "Quản Trị Viên")</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="adminDropdown">
                                            <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                                            <li><a class="dropdown-item" href="/"><i class="bi bi-shop me-2"></i>Xem Cửa Hàng</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="/Account/Login"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nội Dung Động RenderBody -->
                    <div class="main-content">
                        <div class="main-content-inner p-3 p-md-4">
                            @RenderBody()
                        </div>
                        <div class="bottom-page text-center py-3 border-top mt-4 text-muted small">
                            © 2026 Basau Bags - Hệ Thống Quản Trị Bán Hàng Trực Tuyến
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts chuẩn -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/bootstrap-select.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/apexcharts/apexcharts.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/data.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


@model DoAnLTW.Areas.Admin.ViewModels.PaginationViewModel
@{
    // hiển thị tối đa 5 số trang quanh trang hiện tại
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-20">
    <span class="text-muted small">
        Trang @Model.Page / @Model.TotalPages · Tổng @Model.TotalItems mục
    </span>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination mb-0 flex-wrap">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteFor(Model.Page - 1)" aria-label="Trang trước">&laquo;</a>
                </li>
                @for (var i = from; i <= to; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteFor(i)">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteFor(Model.Page + 1)" aria-label="Trang sau">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

@model DoAnLTW.Areas.Admin.ViewModels.PromotionFormViewModel
@{
    var selected = Model.SelectedMaTui.ToHashSet();
}

<!-- danh sách checkbox chọn túi xách áp dụng khuyến mãi (dùng chung cho Add và Edit) -->
<fieldset class="mb-24">
    <div class="body-title mb-10">
        Sản phẩm áp dụng
        <span class="text-muted small fw-normal">(đã chọn <span id="pickedCount">@selected.Count</span> / @Model.SanPhamOptions.Count)</span>
    </div>
    <p class="text-muted small mb-10">
        Mỗi túi chỉ thuộc một khuyến mãi. Tick túi đang thuộc khuyến mãi khác sẽ <strong>chuyển</strong> túi đó sang khuyến mãi này.
    </p>

    @if (Model.SanPhamOptions.Count == 0)
    {
        <div class="alert alert-secondary mb-0">Chưa có sản phẩm nào để áp dụng.</div>
    }
    else
    {
        <div class="table-responsive border rounded-3" style="max-height: 420px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th class="text-center" style="width: 56px;">
                            <input class="form-check-input" type="checkbox" id="pickAll" title="Chọn tất cả" aria-label="Chọn tất cả sản phẩm" />
                        </th>
                        <th style="width: 70px;">Ảnh</th>
                        <th>Sản phẩm</th>
                        <th class="text-end" style="width: 130px;">Đơn giá</th>
                        <th style="width: 200px;">Đang thuộc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sp in Model.SanPhamOptions)
                    {
                        var thuocKmKhac = sp.MaKMHienTai != null && sp.MaKMHienTai != Model.MaKM;
                        <tr>
                            <td class="text-center">
                                <input class="form-check-input pick-item" type="checkbox" name="SelectedMaTui"
                                       value="@sp.MaTui" id="pick-@sp.MaTui" @(selected.Contains(sp.MaTui) ? "checked" : "") />
                            </td>
                            <td>
                                <img src="~/HinhAnh/@(sp.HinhAnh ?? "tui1_1.png")" alt="@sp.TenTui"
                                     style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px;" />
                            </td>
                            <td>
                                <label for="pick-@sp.MaTui" class="mb-0" style="cursor: pointer;">
                                    <span class="text-muted small">@sp.MaHienThi</span><br />@sp.TenTui
                                </label>
                            </td>
                            <td class="text-end">@sp.DonGia.ToString("N0") đ</td>
                            <td>
                                @if (sp.MaKMHienTai == null)
                                {
                                    <span class="text-muted small">Chưa có khuyến mãi</span>
                                }
                                else if (thuocKmKhac)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">KM@(sp.MaKMHienTai.Value.ToString("D2")) · @sp.TenKMHienTai</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success">Khuyến mãi này</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <script>
            // "Chọn tất cả" + đếm số sản phẩm đã tick (chỉ hỗ trợ thao tác; server vẫn kiểm tra mã túi)
            (function () {
                const items = Array.from(document.querySelectorAll('.pick-item'));
                const all = document.getElementById('pickAll');
                const count = document.getElementById('pickedCount');
                function refresh() {
                    const n = items.filter(i => i.checked).length;
                    count.textContent = n;
                    all.checked = n === items.length;
                    all.indeterminate = n > 0 && n < items.length;
                }
                items.forEach(i => i.addEventListener('change', refresh));
                all.addEventListener('change', () => { items.forEach(i => i.checked = all.checked); refresh(); });
                refresh();
            })();
        </script>
    }
</fieldset>

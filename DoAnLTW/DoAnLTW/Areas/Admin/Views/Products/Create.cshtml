@model DoAnLTW.Areas.Admin.ViewModels.ProductCreateViewModel
@using DoAnLTW.Models
@{
    ViewData["Title"] = "Thêm túi xách mới";
    var loaiTuis = ViewBag.LoaiTuis as List<LoaiTui> ?? new List<LoaiTui>();
    var thuongHieus = ViewBag.ThuongHieus as List<ThuongHieu> ?? new List<ThuongHieu>();
}

<div class="main-content-wrap">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">Thêm Túi Xách Mới</h3>
            <p class="text-muted small mb-0">Nhập thông tin sản phẩm và tải ảnh lên</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-0 px-3">
            ← Quay lại danh sách
        </a>
    </div>

    <div class="wg-box" style="max-width: 900px; margin: 0 auto;">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="TenTui" class="form-label small fw-bold text-secondary">Tên túi xách *</label>
                    <input asp-for="TenTui" class="form-control rounded-0" placeholder="Ví dụ: Balo laptop thời trang Basau Pro..." required />
                    <span asp-validation-for="TenTui" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLoai" class="form-label small fw-bold text-secondary">Loại túi *</label>
                    <select asp-for="MaLoai" class="form-select rounded-0" required>
                        <option value="">-- Chọn loại túi --</option>
                        @foreach (var lt in loaiTuis)
                        {
                            <option value="@lt.maLoai">@lt.tenLoai</option>
                        }
                    </select>
                    <span asp-validation-for="MaLoai" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaThuongHieu" class="form-label small fw-bold text-secondary">Thương hiệu *</label>
                    <select asp-for="MaThuongHieu" class="form-select rounded-0" required>
                        <option value="">-- Chọn thương hiệu --</option>
                        @foreach (var th in thuongHieus)
                        {
                            <option value="@th.maThuongHieu">@th.tenThuongHieu</option>
                        }
                    </select>
                    <span asp-validation-for="MaThuongHieu" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DonGia" class="form-label small fw-bold text-secondary">Đơn giá (VNĐ) *</label>
                    <input asp-for="DonGia" type="number" step="1000" class="form-control rounded-0" placeholder="Ví dụ: 350000" required />
                    <span asp-validation-for="DonGia" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoLuong" class="form-label small fw-bold text-secondary">Số lượng tồn kho *</label>
                    <input asp-for="SoLuong" type="number" min="0" class="form-control rounded-0" placeholder="10" required />
                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Badge" class="form-label small fw-bold text-secondary">Nhãn nổi bật (Badge)</label>
                    <input asp-for="Badge" class="form-control rounded-0" placeholder="Ví dụ: HOT, SALE, NEW, -20%..." />
                    <span asp-validation-for="Badge" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-secondary">Hình ảnh sản phẩm</label>
                    <input type="file" name="hinhAnh" id="fileUpload" class="form-control rounded-0" accept="image/*" onchange="previewImage(this);" />
                    <div class="form-text small">Hỗ trợ JPG, PNG, WEBP.</div>
                </div>

                <!-- Preview hinh anh -->
                <div class="col-12 mt-2">
                    <div id="imagePreviewWrap" style="display: none;">
                        <span class="small text-muted d-block mb-1">Xem trước ảnh:</span>
                        <img id="imagePreview" src="#" alt="Preview" class="border p-1" style="max-width: 150px; max-height: 150px; object-fit: cover;" />
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label small fw-bold text-secondary">Mô tả chi tiết</label>
                    <textarea asp-for="MoTa" class="form-control rounded-0" rows="4" placeholder="Chất liệu da cao cấp, chống thấm nước, kích thước 30x20cm..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <div class="col-12 text-end pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-0 px-4 me-2">Hủy</a>
                    <button type="submit" class="btn btn-dark rounded-0 px-4 fw-semibold">Lưu sản phẩm</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewWrap').style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

@model List<DoAnLTW.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="main-content-wrap">
    <div class="mb-27">
        <h3>Quản lý Sản phẩm</h3>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-20" role="alert">
            <i class="icon-alert-octagon me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="wg-box">
        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-filter flex-grow">
                <h5>Danh sách Túi xách</h5>
            </div>
            <a class="tf-button style-1 w208" asp-action="Add">
                <i class="icon-plus"></i>Thêm sản phẩm
            </a>
        </div>

        <div class="wg-table table-all-user">
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 80px;">Mã</th>
                            <th style="min-width: 280px;">Sản phẩm</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center">Loại túi</th>
                            <th class="text-center">Thương hiệu</th>
                            <th class="text-center" style="width: 100px;">Kho</th>
                            <th class="text-center" style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var imgName = string.IsNullOrEmpty(item.HinhAnhChinh) ? "tui1_1.png" : item.HinhAnhChinh;
                                <tr>
                                    <td class="text-center"><span class="body-title-2">@item.MaHienThi</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3 py-1">
                                            <div class="flex-shrink-0" style="width: 50px; height: 50px;">
                                                <img src="~/HinhAnh/@imgName" 
                                                     alt="" 
                                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6;" />
                                            </div>
                                            <div>
                                                <a asp-action="Edit" asp-route-id="@item.MaTui" class="body-title-2 fw-bold text-dark d-block">
                                                    @item.TenTui
                                                </a>
                                                @if (!string.IsNullOrEmpty(item.Badge))
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle mt-1" style="font-size: 11px;">
                                                        @item.Badge
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold text-danger">@item.DonGia.ToString("N0") đ</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border px-3 py-2">@item.TenLoai</span></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border px-3 py-2">@item.TenThuongHieu</span></td>
                                    <td class="text-center fw-bold">@item.SoLuong</td>
                                    <td>
                                        <div class="list-icon-function justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@item.MaTui" title="Chỉnh sửa">
                                                <div class="item edit">
                                                    <i class="icon-edit-3"></i>
                                                </div>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.MaTui" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa túi xách này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="border-0 bg-transparent p-0" title="Xóa">
                                                    <div class="item text-danger delete">
                                                        <i class="icon-trash-2"></i>
                                                    </div>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

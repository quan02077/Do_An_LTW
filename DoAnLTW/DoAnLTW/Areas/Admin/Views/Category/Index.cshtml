@model DoAnLTW.ViewModels.CategoryIndexViewModel
@{
    ViewData["Title"] = "Quản lý Danh mục & Thương hiệu";
}

<div class="main-content-wrap">
    <div class="mb-27">
        <h3>Quản lý Danh mục & Thương hiệu</h3>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-20" role="alert">
            <i class="icon-alert-octagon me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. BẢNG LOẠI TÚI -->
    <div class="wg-box mb-30" id="category-section">
        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-filter flex-grow">
                <h5>Danh sách Loại túi</h5>
            </div>
            <a class="tf-button style-1 w208" asp-action="AddLoaiTui">
                <i class="icon-plus"></i>Thêm Loại túi
            </a>
        </div>
        <div class="wg-table table-all-user">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Mã</th>
                            <th>Tên loại túi</th>
                            <th class="text-center" style="width: 180px;">Số lượng sản phẩm</th>
                            <th class="text-center" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LoaiTuis != null && Model.LoaiTuis.Any())
                        {
                            foreach (var item in Model.LoaiTuis)
                            {
                                <tr>
                                    <td><span class="body-title-2">@item.MaHienThi</span></td>
                                    <td><span class="body-title-2 fw-bold">@item.TenLoai</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-3 py-2">@item.SoLuongSanPham sản phẩm</span>
                                    </td>
                                    <td>
                                        <div class="list-icon-function justify-content-center">
                                            <a asp-action="EditLoaiTui" asp-route-maLoai="@item.MaLoai" title="Chỉnh sửa">
                                                <div class="item edit">
                                                    <i class="icon-edit-3"></i>
                                                </div>
                                            </a>
                                            <form asp-action="DeleteLoaiTui" asp-route-maLoai="@item.MaLoai" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa loại túi này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="border-0 bg-transparent p-0" title="Xóa">
                                                    <div class="item text-danger delete">
                                                        <i class="icon-trash-2"></i>
                                                    </div>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có loại túi nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. BẢNG THƯƠNG HIỆU -->
    <div class="wg-box" id="brand-section">
        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-filter flex-grow">
                <h5>Danh sách Thương hiệu</h5>
            </div>
            <a class="tf-button style-1 w208" asp-action="AddThuongHieu">
                <i class="icon-plus"></i>Thêm Thương hiệu
            </a>
        </div>
        <div class="wg-table table-all-user">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Mã</th>
                            <th>Tên thương hiệu</th>
                            <th class="text-center" style="width: 180px;">Số lượng sản phẩm</th>
                            <th class="text-center" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ThuongHieus != null && Model.ThuongHieus.Any())
                        {
                            foreach (var item in Model.ThuongHieus)
                            {
                                <tr>
                                    <td><span class="body-title-2">@item.MaHienThi</span></td>
                                    <td><span class="body-title-2 fw-bold">@item.TenThuongHieu</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-3 py-2">@item.SoLuongSanPham sản phẩm</span>
                                    </td>
                                    <td>
                                        <div class="list-icon-function justify-content-center">
                                            <a asp-action="EditThuongHieu" asp-route-maThuongHieu="@item.MaThuongHieu" title="Chỉnh sửa">
                                                <div class="item edit">
                                                    <i class="icon-edit-3"></i>
                                                </div>
                                            </a>
                                            <form asp-action="DeleteThuongHieu" asp-route-maThuongHieu="@item.MaThuongHieu" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thương hiệu này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="border-0 bg-transparent p-0" title="Xóa">
                                                    <div class="item text-danger delete">
                                                        <i class="icon-trash-2"></i>
                                                    </div>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có thương hiệu nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
